# ─────────────────────────────────────────────────────────────────
# Subly — Environment Variables
# Copy to .env (development) and configure in Vercel (production).
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────

# Neon Postgres (connection string from your Neon project dashboard)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx-pooler.region.aws.neon.tech/subly?sslmode=require

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-random-secret
# Comma separated list of admin emails (seeded on first connect)
ADMIN_EMAILS=sarcasticsahal@gmail.com

# Google OAuth (Cloud Console → Credentials → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NVIDIA NIM API (https://build.nvidia.com → API Keys)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# Neon Object Storage / Bucket (S3-compatible). Declare a bucket, then run `neon env pull`
# or create a Storage credential in the Neon console.
NEON_STORAGE_BUCKET=payment-screenshots
NEON_STORAGE_REGION=us-east-2
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Encryption key for access credentials (32 bytes base64). Generate:
# openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Public app URL (used for absolute links, SEO, OAuth callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support contact shown across the storefront
NEXT_PUBLIC_SUPPORT_EMAIL=support@subly.pk

# Optional: rate limiting sentinel (defaults to in-memory; fine for development)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=